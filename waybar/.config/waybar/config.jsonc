// ~/.config/waybar/config.jsonc
//
// Waybar as a port of sketchybar/.config/sketchybar/sketchybarrc. The geometry is
// copied over literally:
//
//   sketchybar --bar height=32 color=0x00000000 blur_radius=30 position=top
//                    margin=5 y_offset=8 border_width=0
//
// The bar itself is fully transparent; the visible "glass capsules" are the bracket
// groups, styled in style.css. Anything that was a `--add bracket` there is a
// `group/...` here.
{
  "layer": "top",
  "position": "top",
  "spacing": 0,

  // The surface height must equal the capsules' full visual footprint, top margin
  // included — never `height: 28` plus a `margin-top` on the window. waybar derives
  // its exclusive zone from the layer surface's height, so a top margin pushes the
  // bar down into space nothing reserved and windows tile *under* it.
  //
  // 36 = style.css's 8px top margin + 1px border + 26px capsule + 1px border + 0px
  // bottom margin. The bottom margin is deliberately 0: it makes the capsule's lower
  // edge flush with the bottom of the exclusive zone, so hyprland.lua's gaps_out.top
  // is the entire gap between the bar and the window below it — set to 5, you get 5.
  // With the old 3px bottom margin the two stacked and a lone window (WezTerm on
  // workspace 1) ended up ~3px under the capsule, which looked like an overlap.
  //
  // Change any of those five numbers and this one moves with them. Verify with
  // `hyprctl layers | grep -A2 waybar` — the surface should measure 36 tall.
  // `height` is a minimum, not a cap: if a font in style.css's stack is missing and
  // GTK substitutes one with taller metrics, the bar grows past it and eats screen.
  "height": 36,
  "margin-left": 5,
  "margin-right": 5,

  // Reserve the bar's own strip so windows tile beneath it rather than under it.
  // hyprland.lua's gaps_out adds breathing room on top of this.
  "exclusive": true,
  "fixed-center": true,

  "modules-left": ["group/spaces", "group/app"],
  "modules-center": [],
  "modules-right": ["mpris", "group/sys_tray", "group/battery_clock"],

  // ── Left: workspace indicators ────────────────────────────────────────────────
  // The macOS side used a Rust plugin to render AeroSpace workspaces with the app
  // icons living in each one. Waybar does the same thing natively via
  // window-rewrite, so there is nothing to compile here.
  "group/spaces": {
    "orientation": "horizontal",
    "modules": ["hyprland/workspaces"]
  },

  "hyprland/workspaces": {
    "format": "{name} {windows}",
    "format-window-separator": " ",
    // Every glyph below is a Material Design Icon (U+F0001-U+F1AF0). That is not a
    // style preference — it is the fix for "some apps get an icon and some don't".
    //
    // This map used to mix MDI codepoints with older Nerd Font Private Use Area ones
    // (U+E000-U+F8FF): a terminal glyph for WezTerm, a Firefox glyph for Brave, and
    // so on. Every PUA character in this file was silently stripped to an empty
    // string somewhere in its edit history, while the MDI ones survived — which is
    // exactly the pattern you saw. VS Code, Zen, Antigravity and Obsidian kept their
    // icons because they were MDI; WezTerm, kitty, Brave, Spotify, Thunar, mpv and
    // Discord lost theirs because they were PUA.
    //
    // So: MDI only, everywhere in this file. If an icon ever goes blank again, check
    // for an empty string here before suspecting the font.
    "window-rewrite-default": "",
    "window-rewrite": {
      "class<org.wezfurlong.wezterm>": "",
      "class<wezterm>": "",
      "class<kitty>": "",
      "class<foot>": "",
      "class<Alacritty>": "",
      "class<dev.warp.Warp>": "",
      "class<Code>": "󰨞",
      "class<code-oss>": "󰨞",
      "class<VSCodium>": "󰨞",
      "class<Antigravity>": "󱚝",
      "class<zen>": "",
      "class<zen-alpha>": "",
      "class<zen-twilight>": "",
      "class<zen-browser>": "",
      "class<firefox>": "",
      "class<Brave-browser>": "",
      "class<brave-browser>": "",
      "class<chromium>": "",
      "class<Spotify>": "",
      "class<spotify>": "",
      "class<.*youtube_music.*>": "",
      "class<brave-.*-Default>": "",
      "class<thunar>": "",
      "class<Thunar>": "",
      "class<nautilus>": "",
      "class<mpv>": "",
      "class<discord>": "",
      "class<obsidian>": "",
      "class<[Ww]aypaper>": "",
      "class<org.pulseaudio.pavucontrol>": "",
      "class<pavucontrol>": "",
      "class<rog-control-center>": ""
    },
    "all-outputs": false,
    "show-special": true,
    "special-visible-only": true,
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "sort-by-number": true
  },

  // ── Left: chevron + focused app ───────────────────────────────────────────────
  // sketchybar: `chevron` item (icon ) + `front_app` item, wrapped in left_capsule.
  "group/app": {
    "orientation": "horizontal",
    "modules": ["custom/chevron", "hyprland/window"]
  },

  "custom/chevron": {
    "format": "󰅂",
    "tooltip": false,
    // sketchybar's chevron click_script was `aerospace layout floating tiling`
    "on-click": "hyprctl dispatch togglefloating"
  },

  "hyprland/window": {
    "format": "{class}",
    "rewrite": {
      "": "Desktop",
      "org.wezfurlong.wezterm": "WezTerm",
      "code-oss": "VS Code",
      "Code": "VS Code",
      "zen": "Zen",
      "zen-browser": "Zen",
      "Brave-browser": "Brave",
      "org.pulseaudio.pavucontrol": "Volume"
    },
    "separate-outputs": true,
    "max-length": 28,
    "tooltip-format": "{title}"
  },



  "mpris": {
    "format": "<span font_family='Hack Nerd Font'>{player_icon}</span> {dynamic}",
    "format-paused": "<span font_family='Hack Nerd Font'>{status_icon}</span> <i>{dynamic}</i>",
    "dynamic-order": ["title", "artist"],
    "dynamic-len": 30,
    "interval": 1,
    "player-icons": {
      "default": "󰝚",
      "mpv": "󰐊",
      "firefox": "󰈹",
      "brave": "󰒘",
      "chromium": "󰖟",
      "spotify": "󰓇"
    },
    "status-icons": { "paused": "󰏤" },
    "ignored-players": ["kdeconnect"],
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip-format": "{player}: {title} — {artist}"
  },

  // ── Right: system ─────────────────────────────────────────────────────────────
  // sketchybar's right_capsule held clock + battery. Network and volume are added
  // here because macOS put them in the menu bar, which Linux has no equivalent of.
  "group/sys_tray": {
    "orientation": "horizontal",
    "modules": ["network", "tray"]
  },

  "group/battery_clock": {
    "orientation": "horizontal",
    "modules": ["battery", "clock"]
  },

  // Which GPU mode supergfxctl is in — the one G14-specific thing worth always seeing,
  // since it decides both battery life and whether the dGPU is even available.
  "custom/gpu": {
    "exec": "supergfxctl -g 2>/dev/null | tr -d '\\n'",
    "interval": 30,
    "format": "{}",
    "tooltip": false,
    "on-click": "rog-control-center"
  },

  "network": {
    // Blank until now, and so was every pulseaudio icon below it. Two empty labels
    // sitting between the GPU text and the battery left ~28px of bare padding inside
    // the right capsule, which is the "vague separator before the battery" — not a
    // separator at all, just the hole where the wifi and volume glyphs should be.
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid}  {signalStrength}%  ({ipaddr})",
    "tooltip-format-ethernet": "{ifname}  {ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "nm-connection-editor"
  },

  "pulseaudio": {
    // sketchybar's volume.sh printed a bare percentage with no icon; keep the icon
    // here since there's no menu bar fallback to check.
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-bluetooth": "{icon}󰂯",
    "format-icons": { "headphone": "󰋋", "headset": "󰋎", "default": ["󰕿", "󰖀", "󰕾"] },
    "tooltip-format": "{desc}  {volume}%",
    "on-click": "pavucontrol",
    "on-click-right": "swayosd-client --output-volume mute-toggle",
    "on-scroll-up": "swayosd-client --output-volume raise",
    "on-scroll-down": "swayosd-client --output-volume lower"
  },

  // Glyphs and thresholds match plugins/battery.sh exactly.
  "battery": {
    "states": { "warning": 20, "critical": 10 },
    // The icon is pinned to Hack Nerd Font inline, so the *label* can be styled as
    // ordinary text in style.css. Before this the whole module was Nerd Font at 12px,
    // which made "85%" visibly smaller than the clock and the window title next to it
    // — Nerd Fonts render a given px size smaller than Inter does at the same size.
    // Now the glyph keeps its font and the percentage inherits the bar's 13px Inter.
    "format": "<span font_family='Hack Nerd Font'>{icon}</span> {capacity}%",
    "format-charging": "<span font_family='Hack Nerd Font'>󰂄</span> {capacity}%",
    "format-plugged": "<span font_family='Hack Nerd Font'>󰂄</span> {capacity}%",
    "format-icons": ["󰂃", "󰁼", "󰁾", "󰂀", "󰁹"],
    "interval": 30,
    "tooltip-format": "{timeTo}  ({power}W)"
  },

  // Format string lifted verbatim from plugins/clock.sh: date "+%a %b %d, %H:%M"
  "clock": {
    "interval": 10,
    "format": "{:%a %b %d, %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "format": {
        "months":  "<span color='#ffffff'><b>{}</b></span>",
        "days":    "<span color='#b0b0b0'>{}</span>",
        "weeks":   "<span color='#6eeb91'><b>W{}</b></span>",
        "weekdays":"<span color='#e6d267'><b>{}</b></span>",
        "today":   "<span color='#39ff88'><b><u>{}</u></b></span>"
      }
    },
    "actions": { "on-click-right": "mode", "on-scroll-up": "shift_up", "on-scroll-down": "shift_down" }
  },

  "tray": {
    "icon-size": 15,
    "spacing": 10
  }
}
