# ~/.config/mako/config
#
# Notification daemon, styled to match the waybar capsules. Hyprland blurs behind it
# via the `blur-notifs` layer rule (namespace `notifications`) in hyprland.lua.
#
# Reload after edits with: makoctl reload

sort=-time
layer=overlay
anchor=top-right

# Line up with waybar: 32px bar + 8px top margin + 5px gap.
margin=48,10,10,10
padding=12,14
width=380
height=140

border-size=1
border-radius=12
border-color=#ffffff20
background-color=#050806dd
text-color=#ffffffeb
progress-color=over #6eeb9133

font=Inter 11
icons=1
max-icon-size=40
icon-location=left
markup=1
format=<b>%s</b>\n%b

default-timeout=6000
ignore-timeout=0
max-visible=5

[urgency=low]
text-color=#ffffff99
default-timeout=4000

[urgency=high]
border-color=#ff6978
text-color=#ffffffff
default-timeout=0

[app-name=Volume]
default-timeout=1200
